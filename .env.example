# Pipeline configuration. Copy to .env for local runs.
# Do not commit .env.

# Editorial model. A nano or Haiku-class model is the default.
LLM_API_KEY=
LLM_MODEL=gpt-5-nano
MAX_LLM_USD_PER_RUN=0.25

# Lookback overlaps the previous week so a story on the boundary is not missed.
LOOKBACK_DAYS=8
MAX_CANDIDATES=40
MAX_STORIES=12

# Filled in when the hosted list and sender are connected.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=
